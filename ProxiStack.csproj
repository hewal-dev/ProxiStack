<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>Library</OutputType>
    <RootNamespace>ProxiStack</RootNamespace>
    <AssemblyName>ProxiStack</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>

    <!--
      Pfad zum installierten 7 Days to Die. Überschreiben beim Aufruf:
        msbuild ProxiStack.csproj /p:GameDir="/pfad/zu/7 Days To Die"
      bzw. unter Linux-Default automatisch ermittelt.
    -->
    <GameDir Condition=" '$(GameDir)' == '' ">$(HOME)/.steam/steam/steamapps/common/7 Days To Die</GameDir>
    <ManagedDir>$(GameDir)/7DaysToDie_Data/Managed</ManagedDir>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
  </PropertyGroup>

  <!-- 7DTD v3.x Spiel-Assemblies (werden NICHT mitgeliefert, nur referenziert) -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)/Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="LogLibrary">
      <HintPath>$(ManagedDir)/LogLibrary.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)/UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)/UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Harmony 2.x – liegt neben dem Projekt (siehe README / Release-ZIP) -->
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Quellcode -->
  <ItemGroup>
    <Compile Include="ProxiStack.cs" />
    <Compile Include="ProxiStackConfig.cs" />
    <Compile Include="ContainerHelper.cs" />
    <Compile Include="ProxiStackManager.cs" />
    <Compile Include="Patches.cs" />
    <Compile Include="NetPackageProxiStack.cs" />
  </ItemGroup>
</Project>
