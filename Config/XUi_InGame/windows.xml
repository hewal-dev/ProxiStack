<configs>
	<!-- Standard Backpack Window (Vanilla oder andere Mods)
	     Ab v3.4 ist die Aktionsleiste (rect[@name='actions'], 603 breit) durch
	     Filter-Icons, Kategorie-Grid und Suchfeld sowie den rechtsbuendigen
	     Block mit Schloss/Sortieren/Fill/All (441-601) vollstaendig belegt.
	     Unsere beiden Buttons sitzen deshalb im ungenutzten Freiraum der
	     KOPFZEILE (height 43) rechts neben dem Kreativ-Trash-Button und links
	     vom Geldbetrag: Titel endet bei ~222, Trash 364-396 (nur Kreativmodus),
	     Geldbetrag-Label ab 492, Muenze ab 565.
	     Komplementaere Sichtbarkeit bleibt: beim Looten/Fahrzeugzugriff
	     verschwinden unsere Buttons, Vanillas Fill/All uebernehmen. -->
	<append xpath="/windows/window[@name='windowBackpack']/rect[@name='header']">
		<rect pos="0, 0" visible="{notlootingorvehiclestorage}">
			<button depth="3" name="btnMoveRestock" sprite="ui_game_symbol_restock" tooltip_key="lblStashRestock" pos="420, -22" style="icon32px, press, hover" pivot="center" sound="[paging_click]"/>
			<button depth="3" name="btnMoveStash" sprite="ui_game_symbol_stash" tooltip_key="lblStashStack" pos="460, -22" style="icon32px, press, hover" defaultcolor="[green]" hovercolor="[green]" selectedcolor="[green]" pivot="center" sound="[paging_click]"/>
		</rect>
	</append>

	<!-- AGF Backpack Window: nur vorhanden, wenn AGF-BackpackPlus installiert ist.
	     Ohne dieses Zielmod scheitert der Patch erwartbar und harmlos ("did not apply"). -->
	<append xpath="/windows/window[@name='windowBackpackAGF']/rect[@name='header']/rect[@controller='ContainerStandardControls']">
		<rect pos="0, 0" visible="{notlootingorvehiclestorage}">
			<button depth="3" name="btnMoveRestock" sprite="ui_game_symbol_restock" tooltip_key="lblStashRestock" pos="100, -22" style="icon32px, press, hover" pivot="center" sound="[paging_click]"/>
			<button depth="3" name="btnMoveStash" sprite="ui_game_symbol_stash" tooltip_key="lblStashStack" pos="150, -22" style="icon32px, press, hover" defaultcolor="[green]" hovercolor="[green]" selectedcolor="[green]" pivot="center" sound="[paging_click]"/>
		</rect>
	</append>
</configs>
